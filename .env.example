# Environment variables for MLOps pipeline

# Flask/API
FLASK_ENV=production
FLASK_DEBUG=0
LOG_LEVEL=INFO

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=heart_disease_prediction

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mlops
DB_USER=mlops
DB_PASSWORD=mlops

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Kubernetes
KUBE_NAMESPACE=default
DOCKER_REGISTRY=gcr.io/your-project

# Security
API_KEY=your-secret-key
